# PopinSnake layout. Copy to config/popinsnake.publisher.env and
# replace every REPLACE_ME value before publication.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_POPINSNAKE_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="fonda-vivo-credentials"
WORKFLOW_ENGINE="snakemake-kubernetes"
SNAKEMAKE_PROFILE="popinsnake"

# Paths and selectors as seen from the publisher Pod's PVC mount.
RUN_ROOT="/workspace/runs/REPLACE_ME_RUN_ID"
CODE_PATH="/workspace/runs/REPLACE_ME_RUN_ID/source/workflow"
POD_LABEL_SELECTOR="app.kubernetes.io/name=popinsnake"
# New runs should carry fonda.hu-berlin.de/run-id. Use these fallback fields
# only when collecting an older run without that label.
FALLBACK_RUN_ID="REPLACE_ME_RUN_ID"
JOB_NAME_REGEX="REPLACE_ME_POPINSNAKE_JOB_REGEX"

WORKFLOW_NAME="PopinSnake: exploratory workflow for genomic insertion detection"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/popinsnake-exploratory-genomic-insertion-detection"
WORKFLOW_REPO_URL="https://gitlab.informatik.hu-berlin.de/fonda_a6/popinSnake"
CODE_URI="https://gitlab.informatik.hu-berlin.de/fonda_a6/popinSnake"

PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-doi-10-1109-e-science58273-2023-10254924"
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#KediCao,https://fonda.hu-berlin.de/?page_id=2066#weidlich,https://fonda.hu-berlin.de/?page_id=2066#kehr"
SUBPROJECT_URIS="https://fonda.hu-berlin.de/?page_id=2066#subproject-A6"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/c-cpp,http://example.org/vivo-import/run-metadata/language/python,http://example.org/vivo-import/run-metadata/language/shell"
APPLICATION_DOMAIN_URI="http://example.org/vivo-import/run-metadata/domain/bioinformatics"
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="FONDA Kubernetes Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/snakemake"
PROM_URL="REPLACE_ME_PROMETHEUS_URL"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
ALLOW_MISSING_METRICS="0"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
