# Lotaru layout. Copy to config/lotaru.publisher.env and replace every
# REPLACE_ME value before publication.
#
# Lotaru is not a workflow-engine run. It is the Java program behind the Lotaru
# papers, executed as a single Kubernetes Job: it reads the workflow execution
# traces bundled in its own repository and writes one runtime-prediction CSV per
# target machine. The collector therefore uses the "lotaru" profile, and
# ENGINE_URI names Java rather than a workflow engine.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_LOTARU_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
WORKFLOW_ENGINE="snakemake-kubernetes"
SNAKEMAKE_PROFILE="lotaru"
NODE_USEDBY="prototyping"

# Paths and selectors as seen from the publisher Pod's PVC mount.
RUN_ROOT="/workspace/runs/REPLACE_ME_RUN_ID"
CODE_PATH="/workspace/runs/REPLACE_ME_RUN_ID/source"
POD_LABEL_SELECTOR="app.kubernetes.io/name=lotaru"
FALLBACK_RUN_ID="REPLACE_ME_RUN_ID"
JOB_NAME_REGEX="REPLACE_ME_RUN_ID-run"

WORKFLOW_NAME="Lotaru: local runtime prediction for scientific workflow tasks"
WORKFLOW_DESCRIPTION="Estimates the runtime of scientific workflow tasks on the heterogeneous nodes of a cluster from measurements taken on a single local machine, so that a scheduler can reason about task placement without profiling every node. Microbenchmarks characterise each target machine, a Bayesian ridge regression relates local runtimes to input size, and the estimate is transferred to the target node. This run replays the evaluation of the Lotaru papers over the bundled execution traces of five nf-core workflows on six machines."
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/lotaru-local-runtime-prediction"
WORKFLOW_REPO_URL="https://github.com/CRC-FONDA/Lotaru"
CODE_URI="https://github.com/CRC-FONDA/Lotaru"

# One or more publications, comma separated. Each is linked to the workflow and
# to the run, and each gets rm:hasWorkflowRun back to the run. Both Lotaru
# papers describe this method: the Future Generation Computer Systems article
# extends the SSDBM 2022 paper.
PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-doi-10-1016-j-future-2023-08-022,http://141.20.184.157:8080/vivo/individual/a1-publication-doi-10-1145-3538712-3538739"
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#JonathanBader,https://fonda.hu-berlin.de/?page_id=2066#FabianLehmann,https://fonda.hu-berlin.de/?page_id=2066#ulf,https://fonda.hu-berlin.de/?page_id=2066#kao"
SUBPROJECT_URIS="http://141.20.184.157:8080/vivo/individual/fonda-group-b1-carbon-aware-multi-site-workflow-scheduling-under-uncertainty,http://141.20.184.157:8080/vivo/individual/fonda-group-b5-transparent-multi-site-data-analysis-workflows-for-earth-observation"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/java,http://example.org/vivo-import/run-metadata/language/python"
APPLICATION_DOMAIN_URI=""
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="FONDA Kubernetes Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/java"
PROM_URL="REPLACE_ME_PROMETHEUS_URL"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
ALLOW_MISSING_METRICS="0"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
