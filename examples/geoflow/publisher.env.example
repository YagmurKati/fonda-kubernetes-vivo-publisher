# Tested Geoflow layout. Copy to config/publisher.env and replace REPLACE_ME.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_GEOFLOW_PVC"
SERVICE_ACCOUNT="nextflow-sa"

TRACE_PATH_TEMPLATE="/workspace/results/trace-{run_id}.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/results/nextflow-{run_id}.log"
DEBUG_LOG_PATH="/workspace/geoflow/.nextflow.log"
CODE_PATH="/workspace/geoflow"
TRACE_TIMEZONE="UTC"

WORKFLOW_NAME="Geoflow - annual land-cover mapping across Germany"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/geoflow-annual-land-cover-mapping-across-germany"
WORKFLOW_REPO_URL="https://github.com/CRC-FONDA/geoflow"
CODE_URI="https://github.com/YagmurKati/geoflow-kubernetes-vivo-metadata"
GIT_COMMIT="acd0d618d0451c65ecb12466a412abb65dda1a87"

PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-doi-10-13140-rg-2-2-25203-60963"
TRACE_ARCHIVE="https://box.hu-berlin.de/d/083e70a0414846a5ae77/"
RESPONSIBLE_RESEARCHER_URIS="REPLACE_ME_PERSON_URI"
SUBPROJECT_URIS="REPLACE_ME_SUBPROJECT_URI"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/python,http://example.org/vivo-import/run-metadata/language/shell"
APPLICATION_DOMAIN_URI="REPLACE_ME_APPLICATION_DOMAIN_URI"
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="REPLACE_ME_BACKEND_URI"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="FONDA Kubernetes Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
