# Tested nf-core/rangeland layout. Copy to config/publisher.env and replace REPLACE_ME.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_RANGELAND_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
WORKFLOW_ENGINE="nextflow"

TRACE_PATH_TEMPLATE="/workspace/results/{run_id}/trace-{run_id}.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/results/{run_id}/nextflow-{run_id}.log"
DEBUG_LOG_PATH="/workspace/results/{run_id}/nextflow-debug-{run_id}.log"
CODE_PATH="/workspace/.nextflow/assets/nf-core/rangeland"
TRACE_TIMEZONE="UTC"

WORKFLOW_NAME="Long-term vegetation dynamics in the Mediterranean (nf-core)"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-nf-core"
WORKFLOW_REPO_URL="https://github.com/nf-core/rangeland"
CODE_URI="https://github.com/nf-core/rangeland"

# Digest-pinned images for pipeline release 1.0.0. Successful task pods are
# deleted by k8s.cleanup before collection, so these declarations are what keeps
# the containers in the record. Re-resolve them for a different revision.
