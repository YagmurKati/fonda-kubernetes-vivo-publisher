# Tested RNA-seq STAR RS1 layout for FONDA Kubernetes.
NS="yagmur"
PVC_NAME="rnaseq-star-rs1-pvc"
SERVICE_ACCOUNT="nextflow-sa"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
WORKFLOW_ENGINE="nextflow"

# Paths archived by fonda-nextflow-rs1-star-runner for every run ID.
TRACE_PATH_TEMPLATE="/workspace/results/{run_id}/trace.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/results/{run_id}/nextflow.log"
DEBUG_LOG_PATH="/workspace/results/{run_id}/nextflow-debug.log"
CODE_PATH="/workspace/source"
TRACE_TIMEZONE="UTC"

# The scientific workflow remains owned and maintained by Nine-s.
WORKFLOW_NAME="RNA-seq analysis workflow (STAR, RS1)"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/rna-seq-analysis-star-rs1"
WORKFLOW_REPO_URL="https://github.com/Nine-s/nextflow_RS1_star"
CODE_URI="https://github.com/Nine-s/nextflow_RS1_star"
GIT_COMMIT="8265c835d8fd76c9bad7b1e2499304929069050b"
DECLARED_CONTAINER_IMAGES="ninedem/check_strandedness@sha256:1a8e1b00f51f02ad4c7876975d735b9f4ee7c365f1d499eceb3a35fdea8dcdde,biocontainers/fastp@sha256:36c3841644a023f360c1e33ac2497dc91755d4ace5e2b1162e16304b8f5179d0,nfcore/rnaseq@sha256:683625354fdcdefaad1a2710e4ba0517ac5316e47dddd6148aa8d685282a857b,biocontainers/samtools@sha256:8271d276f6aa27174dc2fc79b12b7919a1751c27070d3b8a53e1f380472b3680,pgcbioinfo/cufflinks@sha256:833b5af0c5790093821aa064f5bd87543d9589b90c4a0450927051594e4bb52d"

PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-url-https-ceur-ws-org-vol-3379-phdworkshop-2023-demecquenem-paper-pdf"
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#NinonDeMequenem"
SUBPROJECT_URIS="http://141.20.184.157:8080/vivo/individual/fonda-group-a2-energy-aware-optimization-of-workflows-in-bioinformatics"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/shell"
APPLICATION_DOMAIN_URI="http://example.org/vivo-import/run-metadata/domain/bioinformatics"
RUN_OPERATOR_URI="https://fonda.hu-berlin.de/?page_id=2066#YagmurKati"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="Fonda Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

# The tested publication used the fixed factor because CO2Map had not yet
# published finite values for the run interval. The RDF records this method.
CARBON_SOURCE="fixed"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
CO2MAP_STATE="DE"
CO2MAP_COUNTRY="DE"
CO2MAP_DATA_STATUS="preliminary"

INCLUDE_CACHED_ORIGIN_METRICS="0"
ALLOW_MISSING_METRICS="0"
REQUIRE_SUCCEEDED="1"
INPUT_METADATA_FILE="examples/rnaseq-star-rs1/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
