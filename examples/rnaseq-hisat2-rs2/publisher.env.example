# Tested RNA-seq HISAT2 RS2 layout for FONDA Kubernetes RUN06.
NS="yagmur"
PVC_NAME="rnaseq-pvc"
SERVICE_ACCOUNT="nextflow-sa"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
