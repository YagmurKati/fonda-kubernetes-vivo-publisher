DEBUG_LOG_PATH="/workspace/results/{run_id}/nextflow-debug-{run_id}-combined.log"
CODE_PATH="/workspace/rnaseq-hisat2-rs2/source"
TRACE_TIMEZONE="UTC"

WORKFLOW_NAME="RNA-seq analysis workflow (HISAT2, RS2)"
