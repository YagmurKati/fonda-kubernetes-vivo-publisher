CARBON_SOURCE="co2map"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
CO2MAP_STATE="DE"
CO2MAP_COUNTRY="DE"
CO2MAP_DATA_STATUS="preliminary"

# RUN06 is a successful resume. Include the still-retained metrics from the
# origin pods of cached tasks and accept COMPLETED+CACHED as terminal success.
INCLUDE_CACHED_ORIGIN_METRICS="1"
ALLOW_MISSING_METRICS="0"
REQUIRE_SUCCEEDED="0"
INPUT_METADATA_FILE="examples/rnaseq-hisat2-rs2/input_datasets.json"
