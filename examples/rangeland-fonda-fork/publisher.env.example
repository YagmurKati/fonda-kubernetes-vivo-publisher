# nf-core/rangeland as maintained in the CRC-FONDA fork. Copy to
# config/publisher.env and replace every REPLACE_ME value.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_RANGELAND_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
WORKFLOW_ENGINE="nextflow"

TRACE_PATH_TEMPLATE="/workspace/results/{run_id}/trace-{run_id}.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/results/{run_id}/nextflow-{run_id}.log"
DEBUG_LOG_PATH="/workspace/results/{run_id}/nextflow-debug-{run_id}.log"
# NXF_HOME is set to /workspace/nextflow-home, so the fetched pipeline lives
# here rather than under the default .nextflow/assets path.
CODE_PATH="/workspace/nextflow-home/assets/CRC-FONDA/nf-core-rangeland"
TRACE_TIMEZONE="UTC"

WORKFLOW_NAME="Long-term vegetation dynamics in the Mediterranean (nf-core)"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-nf-core"
WORKFLOW_REPO_URL="https://github.com/CRC-FONDA/nf-core-rangeland"
CODE_URI="https://github.com/CRC-FONDA/nf-core-rangeland"

# Pipeline version 1.1.0dev declares these images by tag, not digest:
#   nf-core/force:3.10.04
#   docker.io/rocker/geospatial:4.3.1
#   community.wave.seqera.io/library/multiqc:1.34--db7c73dae76bc9e6
# Record the digests the run actually pulled, as a comma-separated list of
# name@sha256:... references. With k8s.cleanup = false the task pods survive,
# so `kubectl get pods -o jsonpath` over their imageID fields yields them.
DECLARED_CONTAINER_IMAGES="REPLACE_ME"

GIT_COMMIT="bbb3da8d51c73ed509afcb228e8ae3e09ad027c2"
PUBLICATION_URI=""
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#david-franz,https://fonda.hu-berlin.de/?page_id=2066#FabianLehmann,https://fonda.hu-berlin.de/?page_id=2066#FelixKummer,https://fonda.hu-berlin.de/?page_id=2066#KasiaLewinska"
SUBPROJECT_URIS="http://141.20.184.157:8080/vivo/individual/fonda-group-b5-transparent-multi-site-data-analysis-workflows-for-earth-observation"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/c-cpp,http://example.org/vivo-import/run-metadata/language/r"
APPLICATION_DOMAIN_URI="http://172.28.33.178:8080/vivo/individual/n5261"
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="Fonda Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
CO2MAP_STATE="DE"
CO2MAP_COUNTRY="DE"
CO2MAP_DATA_STATUS="preliminary"

INCLUDE_CACHED_ORIGIN_METRICS="0"
ALLOW_MISSING_METRICS="0"
REQUIRE_SUCCEEDED="1"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
