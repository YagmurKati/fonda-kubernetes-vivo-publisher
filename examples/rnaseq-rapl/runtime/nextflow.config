plugins { id 'nf-k8s@1.2.2' }
workDir = '/workspace/work'
outputDir = '/workspace/results'
process {
    executor = 'k8s'
    container = 'docker.io/nextflow/rnaseq-nf@sha256:1f451ff552c6b779709a71f4b21cfffacb3661380d7241c8489a169c3476a448'
    cpus = 2
    memory = '8 GB'
    time = '60 min'
    maxForks = 1
    errorStrategy = 'finish'
    maxRetries = 0
    pod = [
        [label: 'app.kubernetes.io/name', value: 'rapl-measurement'],
        [label: 'fonda.hu-berlin.de/run-id', value: '__RUN_ID__'],
        [nodeSelector: 'usedby=prototyping'],
        [affinity: [nodeAffinity: [requiredDuringSchedulingIgnoredDuringExecution: [nodeSelectorTerms: [[matchExpressions: [
            [key: 'usedby', operator: 'In', values: ['prototyping']],
            [key: 'kubernetes.io/hostname', operator: 'In', values: ['__NODE__']]
        ]]]]]]],
        [securityContext: [runAsUser: 57439, runAsGroup: 57439, fsGroup: 57439]],
        [automountServiceAccountToken: false]
    ]
}
executor.queueSize = 1
k8s {
    namespace = '__NAMESPACE__'
    serviceAccount = '__RUN_ID__-runner'
    storageClaimName = '__RUN_ID__-work'
    storageMountPath = '/workspace'
    runAsUser = 57439
    cleanup = false
    cpuLimits = true
    fetchNodeName = true
}
trace {
    enabled = true
    file = '/workspace/run/trace.tsv'
    raw = true
    fields = 'task_id,hash,native_id,name,process,status,exit,submit,start,complete,duration,realtime,cpus,%cpu,rss,peak_rss,read_bytes,write_bytes'
}
report { enabled = true; file = '/workspace/run/report.html' }
timeline { enabled = true; file = '/workspace/run/timeline.html' }

params.reads = '/workspace/inputs/SRR16287545_{1,2}.fastq.gz'
params.transcriptome = '/workspace/inputs/transcriptome.fa'
