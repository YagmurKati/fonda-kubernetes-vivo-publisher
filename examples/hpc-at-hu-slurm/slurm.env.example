# Copy to ~/.fonda-vivo/slurm.env and fill in.
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/REPLACE_ME"
# Only for a workflow that is not in VIVO yet; leave empty for an existing one.
WORKFLOW_LABEL=""
RUN_LABEL=""
RUN_OPERATOR_URI="https://fonda.hu-berlin.de/?page_id=2066#REPLACE_ME"
RESPONSIBLE_RESEARCHER_URIS=""
CODE_REPO_URL=""
# Comma-separated, e.g. http://example.org/vivo-import/run-metadata/language/shell,...language/python
LANGUAGE_URIS=""
# Comma-separated VIVO input dataset URIs
INPUT_DATA_URIS=""
GIT_COMMIT=""
# Nextflow runs only: the launch directory (holds .nextflow.log) and the trace
# file pattern; {JOB_ID} is replaced by the Slurm job ID.
NEXTFLOW_LAUNCH_DIR=""
NEXTFLOW_TRACE_GLOB=""
# Example: NEXTFLOW_TRACE_GLOB="/lustre/.../results-{JOB_ID}/pipeline_info/execution_trace_*.txt"
