#!/bin/bash
#SBATCH --job-name=rangeland-test
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=02:00:00
# nf-core/rangeland 1.0.0, test profile, on one HPC@HU node.
# Copy to $WORK/rangeland-test.sbatch and set WORK to your Lustre directory.

WORK=/lustre/GROUP/USER/fonda

module load nextflow/2025.03.06
# Apptainer images and build files go to Lustre; the home quota is too small.
export NXF_APPTAINER_CACHEDIR="$WORK/apptainer-cache"
export APPTAINER_CACHEDIR="$WORK/apptainer-cache"
export APPTAINER_TMPDIR="$WORK/apptainer-tmp"
export NXF_OPTS="-Xms1g -Xmx4g"
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"
cd "$WORK"

"$WORK/fonda-kubernetes-vivo-publisher/collector/slurm/run-with-node-sampler.sh" \
  "$HOME/vivo-evidence/$SLURM_JOB_ID" -- \
  nextflow run nf-core/rangeland -r 1.0.0 -profile test,apptainer --outdir "results-$SLURM_JOB_ID"
