# Tested FORCE2NXF layout. Copy to config/publisher.env and replace REPLACE_ME.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_FORCE2NXF_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="fonda-vivo-credentials"
WORKFLOW_ENGINE="nextflow"

TRACE_PATH_TEMPLATE="/workspace/rangeland/results/trace-{run_id}.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/rangeland/results/nextflow-{run_id}.log"
DEBUG_LOG_PATH="/workspace/rangeland/FORCE2NXF-Rangeland/nextflowWF/.nextflow.log"
CODE_PATH="/workspace/rangeland/FORCE2NXF-Rangeland"
TRACE_TIMEZONE="UTC"

WORKFLOW_NAME="Long-term vegetation dynamics in the Mediterranean (FORCE2NXF)"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-force2nxf"
WORKFLOW_REPO_URL="https://github.com/CRC-FONDA/FORCE2NXF-Rangeland"
CODE_URI="https://github.com/YagmurKati/force2nxf-rangeland-vivo-metadata"
GIT_COMMIT="179ea79ee7cadc7975be2442f3dfcd250f59202e"

PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-key-lehmann2021forceon"
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="REPLACE_ME_PERSON_URI"
SUBPROJECT_URIS="REPLACE_ME_SUBPROJECT_URI"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/shell,http://example.org/vivo-import/run-metadata/language/r"
APPLICATION_DOMAIN_URI="REPLACE_ME_APPLICATION_DOMAIN_URI"
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="REPLACE_ME_BACKEND_URI"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="FONDA Kubernetes Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
