# Tested docker-nextflow-node layout. Copy to config/publisher.env and replace REPLACE_ME.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_ECHO_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
WORKFLOW_ENGINE="nextflow"

TRACE_PATH_TEMPLATE="/workspace/results/{run_id}/trace-{run_id}.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/results/{run_id}/nextflow-{run_id}.log"
DEBUG_LOG_PATH="/workspace/results/{run_id}/nextflow-debug-{run_id}.log"
CODE_PATH="/workspace/source"
TRACE_TIMEZONE="UTC"

# The upstream project targets a local Apache Ignite cluster. The Ignite
# executor no longer exists in current Nextflow, so this run used the
# Kubernetes executor; the executor variant is part of the workflow identity.
WORKFLOW_NAME="Nextflow echo test workflow (docker-nextflow-node, Kubernetes executor)"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/nextflow-echo-test-workflow-docker-nextflow-node-kubernetes-executor"
WORKFLOW_REPO_URL="https://github.com/rafaelmoczalla/docker-nextflow-node"
CODE_URI="https://github.com/rafaelmoczalla/docker-nextflow-node"

# test.nf declares no container; the Kubernetes executor needs one per task.
DECLARED_CONTAINER_IMAGES="docker.io/nextflow/nextflow@sha256:b86e934a59e3df6a0d5f83f7369ad97b36d083ba174b8a92f3a900db4ec47a9e"

GIT_COMMIT="2e05df51334faec0135d1c43643377425fdd44f3"
PUBLICATION_URI=""
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#RafaelMoczalla"
SUBPROJECT_URIS="http://141.20.184.157:8080/vivo/individual/fonda-group-b6-end-to-end-energy-profiles-of-ml-based-data-analysis-workflows"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/shell"
# Left empty on purpose: VIVO offers bioinformatics, earth-systems-science and
# metagenomics, none of which describe a synthetic echo benchmark.
APPLICATION_DOMAIN_URI=""
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="Fonda Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
CO2MAP_STATE="DE"
CO2MAP_COUNTRY="DE"
CO2MAP_DATA_STATUS="preliminary"

INCLUDE_CACHED_ORIGIN_METRICS="0"
ALLOW_MISSING_METRICS="0"
REQUIRE_SUCCEEDED="1"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
