# FONDA_trends layout. Copy to config/publisher.env and replace REPLACE_ME.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_TRENDS_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="fonda-vivo-credentials"
WORKFLOW_ENGINE="nextflow"

TRACE_PATH_TEMPLATE="/workspace/out/trace-force.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/out/console-force.log"
DEBUG_LOG_PATH="/workspace/out/nextflow-force.log"
CODE_PATH="/workspace/wf"
TRACE_TIMEZONE="UTC"

WORKFLOW_NAME="Trends in European Grasslands: test-site study"
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/trends-in-european-grasslands-test-site-study"
WORKFLOW_REPO_URL="https://github.com/erfea/FONDA_trends-nf"
CODE_URI="https://github.com/erfea/FONDA_trends-nf"

PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-doi-10-1016-j-rse-2025-114736"
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#KasiaLewinska,https://fonda.hu-berlin.de/?page_id=2066#FabianLehmann,https://fonda.hu-berlin.de/?page_id=2066#FelixKummer"
SUBPROJECT_URIS="http://141.20.184.157:8080/vivo/individual/fonda-group-b5-transparent-multi-site-data-analysis-workflows-for-earth-observation"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/shell,http://example.org/vivo-import/run-metadata/language/r"
APPLICATION_DOMAIN_URI="http://example.org/vivo-import/run-metadata/domain/remote-sensing"
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="FONDA Kubernetes Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"

INCLUDE_CACHED_ORIGIN_METRICS="0"
ALLOW_MISSING_METRICS="0"
REQUIRE_SUCCEEDED="1"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
