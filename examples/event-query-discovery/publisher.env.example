# Event query discovery testbench (Google cluster traces, BTW23) on the FONDA
# Kubernetes cluster. A plain Python program run as one Kubernetes Job per
# sample; published through the Kubernetes-native (pod-based) collector.
NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_RESULTS_PVC"
SERVICE_ACCOUNT="REPLACE_ME_SERVICE_ACCOUNT"
VIVO_CREDENTIALS_SECRET="vivo-publisher-credentials"
# The pod-based collector path. SNAKEMAKE_PROFILE selects the result reader;
# the workflow itself is not Snakemake (see ENGINE_URI).
WORKFLOW_ENGINE="snakemake-kubernetes"
SNAKEMAKE_PROFILE="eqd"
NODE_USEDBY="prototyping"

RUN_ROOT="/workspace"
CODE_PATH="/workspace/source"
POD_LABEL_SELECTOR="app=event-query-discovery-btw23-20260915"
FALLBACK_RUN_ID="btw23-20260915"
JOB_NAME_REGEX="event-query-discovery-btw23-20260915-google-query(1|2-no-rtl|3)"
EQD_RUN_DIR_PREFIX="google-btw23-c898ae4f-20260915"
EQD_PYTHON_VERSION="3.10"

WORKFLOW_NAME="Event query discovery from Google cluster traces"
WORKFLOW_DESCRIPTION="Testbench for discovering multi-dimensional subsequence queries with wildcards and gap-size constraints from event traces, run on three samples derived from the Google cluster traces used for the BTW 2023 paper. For each sample it runs the discovery algorithm under three support thresholds and several position and operation selection strategies, and records the mined query, runtime and match-test statistics of every discovery."
WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/event-query-discovery-from-google-cluster-traces"
WORKFLOW_REPO_URL="https://gitlab.com/kleemeis95/sfb-1404-fonda-querydiscovery-prototype"
CODE_URI="https://gitlab.com/kleemeis95/sfb-1404-fonda-querydiscovery-prototype"

PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-doi-10-18420-btw2023-24"
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS="https://fonda.hu-berlin.de/?page_id=2066#SarahKM"
SUBPROJECT_URIS="http://141.20.184.157:8080/vivo/individual/fonda-group-a1-query-driven-validation-of-distributed-daws"
LANGUAGE_URIS="http://example.org/vivo-import/run-metadata/language/python"
# No existing application domain describes event query discovery over cluster traces.
APPLICATION_DOMAIN_URI=""
RUN_OPERATOR_URI="REPLACE_ME_PERSON_URI"
BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"

CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="Fonda Cluster"
# The program has no workflow engine; it is a Python program scheduled by Kubernetes.
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/python"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"
CO2MAP_STATE="DE"
CO2MAP_COUNTRY="DE"
CO2MAP_DATA_STATUS="preliminary"

ALLOW_MISSING_METRICS="0"
REQUIRE_SUCCEEDED="1"
INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
