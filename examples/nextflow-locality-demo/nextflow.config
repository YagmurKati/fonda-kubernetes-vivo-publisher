workDir = '/workspace/work/NFL-DSL2-DEMO-RUN01'

process {
    executor = 'k8s'
    shell = ['/bin/bash', '-ue']
    container = 'nextflow/nextflow@sha256:b035b9fa7243ed09b9896c2b752d9e399f337827932bd45495efb0aed8e1dca1'
    cpus = 1
    memory = '128 MB'
    maxForks = 1

    // Both settings are hard scheduling constraints. The duplicated rule is
    // intentional: a task must match usedby=prototyping to be scheduled.
    pod = [
        [label: 'fonda.hu-berlin.de/run-id', value: 'NFL-DSL2-DEMO-RUN01'],
        [label: 'app.kubernetes.io/name', value: 'nextflow-locality-demo'],
        [nodeSelector: 'usedby=prototyping'],
        [affinity: [
            nodeAffinity: [
                requiredDuringSchedulingIgnoredDuringExecution: [
                    nodeSelectorTerms: [[
                        matchExpressions: [[
                            key: 'usedby',
                            operator: 'In',
                            values: ['prototyping']
                        ]]
                    ]]
                ]
            ]
        ]]
    ]
}

k8s {
    namespace = 'yagmur'
    serviceAccount = 'nextflow-sa'
    storageClaimName = 'nextflow-locality-demo-workspace'
    storageMountPath = '/workspace'
    workDir = '/workspace/work/NFL-DSL2-DEMO-RUN01'
    cleanup = false
}
