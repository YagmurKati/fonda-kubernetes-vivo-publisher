# Copy this file to config/publisher.env and replace every REPLACE_ME value.
# This file contains public metadata and Kubernetes object names, not passwords.

NS="REPLACE_ME_NAMESPACE"
PVC_NAME="REPLACE_ME_PVC"
SERVICE_ACCOUNT="nextflow-sa"
VIVO_CREDENTIALS_SECRET="fonda-vivo-credentials"
WORKFLOW_ENGINE="nextflow"

# Paths as seen inside the shared PVC, which this toolkit mounts at /workspace.
TRACE_PATH_TEMPLATE="/workspace/results/trace-{run_id}.txt"
CONSOLE_LOG_PATH_TEMPLATE="/workspace/results/nextflow-{run_id}.log"
DEBUG_LOG_PATH="/workspace/workflow/.nextflow.log"
CODE_PATH="/workspace/workflow"
TRACE_TIMEZONE="UTC"

# Public identity of the workflow. Use stable HTTP(S) URIs.
WORKFLOW_NAME="REPLACE_ME_WORKFLOW_NAME"
WORKFLOW_URI="https://example.org/vivo-import/run-metadata/workflow/REPLACE_ME"
WORKFLOW_REPO_URL="https://github.com/REPLACE_ME/REPLACE_ME"
CODE_URI="https://github.com/REPLACE_ME/REPLACE_ME"
GIT_COMMIT=""

# Optional existing VIVO/public resources. Empty values are omitted.
PUBLICATION_URI=""
TRACE_ARCHIVE=""
RESPONSIBLE_RESEARCHER_URIS=""
SUBPROJECT_URIS=""
LANGUAGE_URIS=""
APPLICATION_DOMAIN_URI=""
RUN_OPERATOR_URI=""
BACKEND_URI=""

# Shared FONDA resources and services.
CLUSTER_URI="http://example.org/vivo-import/run-metadata/cluster/fonda-cluster"
CLUSTER_LABEL="FONDA Kubernetes Cluster"
ENGINE_URI="http://example.org/vivo-import/run-metadata/engine/nextflow"
PROM_URL="http://prometheus-kube-prometheus-prometheus.monitoring.svc.fonda:9090"

# electricity-maps-latest uses the newest free-tier value as a collection-time
# proxy. Use fixed only when no Electricity Maps token is available.
CARBON_SOURCE="electricity-maps-latest"
CARBON_INTENSITY="0.4"
ELECTRICITY_MAPS_ZONE="DE"

INPUT_METADATA_FILE="config/input_datasets.json"
BASE_URI="http://example.org/vivo-import/run-metadata/"
ONTOLOGY_URI="http://example.org/ontology/run-metadata#"
VIVO_ENDPOINT="https://vivo-fonda.hu-berlin.de/vivo/api/sparqlUpdate"
VIVO_GRAPH="http://vitro.mannlib.cornell.edu/default/vitro-kb-2"
